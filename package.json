{
  "name": "openhot",
  "version": "1.0.0",
  "description": "开源热点（OpenHot）：追踪 GitHub 与开源社区新出现的仓库、快速涨星与版本发布的行业热点站，基于 AIHOT 框架。",
  "license": "MIT",
  "author": "reisen-ww",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reisen-ww/OpenHot.git"
  },
  "homepage": "https://github.com/reisen-ww/OpenHot#readme",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry",
    "site",
    "modules/*"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "npm run dev -w @aihot/api",
    "dev:worker": "npm run dev -w @aihot/worker",
    "dev:web": "npm run dev -w @aihot/web",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && tsc -p modules && npm run typecheck -w @aihot/web",
    "test": "node --test-global-setup=tests/databases.ts --import ./tests/databases.ts --test --test-concurrency=6 --test-timeout=120000 \"tests/*.test.ts\" \"modules/*/tests/*.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  }
}
