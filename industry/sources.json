{
  "$comment": "示范信源：首次启动时导入（scripts/seed.ts），已存在的不会被覆盖。之后在后台“信源”里新建、修改和暂停。字段说明见 docs/customize.md。",
  "sources": [
    {
      "id": "open-github-trending",
      "name": "GitHub Trending 日榜",
      "kind": "web_list",
      "config": {
        "url": "https://github.com/trending?since=daily",
        "itemSelector": "article.Box-row",
        "linkSelector": "h2 a",
        "titleSelector": "h2 a",
        "ingestNoiseFilter": {
          "dropMarkersTitleOnly": [
            "awesome",
            "面试",
            "interview",
            "leetcode",
            "刷题",
            "dotfiles",
            "中文翻译",
            "翻译版"
          ]
        }
      },
      "tier": "T1",
      "owner_entity_id": "github",
      "participation_mode": "editorial",
      "interval_minutes": 120,
      "tags": [
        "仓库",
        "趋势",
        "英文"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "open-github-new-repos",
      "name": "GitHub 新仓库（月内新建高星）",
      "kind": "json_list",
      "config": {
        "url": "https://api.github.com/search/repositories?q=created:%3E2025-06-01+stars:%3E200&sort=stars&order=desc&per_page=20",
        "headers": {
          "Accept": "application/vnd.github+json"
        },
        "itemsPath": "items",
        "titlePaths": [
          "full_name"
        ],
        "summaryPaths": [
          "description"
        ],
        "publishedAtPath": "created_at",
        "externalIdPath": "full_name",
        "urlTemplate": "https://github.com/{full_name}",
        "minNumeric": {
          "path": "stargazers_count",
          "min": 200
        },
        "ingestNoiseFilter": {
          "dropMarkersTitleOnly": [
            "awesome",
            "面试",
            "interview",
            "leetcode",
            "刷题",
            "dotfiles",
            "中文翻译",
            "翻译版"
          ]
        }
      },
      "tier": "T1",
      "owner_entity_id": "github",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [
        "仓库",
        "新项目",
        "英文"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
